@page "/"

<PageTitle>Painel da Oficina</PageTitle>

<div class="container-fluid py-3">

    <div class="bg-white rounded-3 shadow-sm p-4 mb-4">

        <h1 class="fw-bold text-dark">
            Painel da Oficina
        </h1>

        <p class="fs-5 mb-2">
            Bem-vindo ao sistema de gestão da Oficina Mecânica.
        </p>

        <p class="text-secondary mb-0">
            Acompanhe os atendimentos, gerencie clientes e veículos
            e consulte as ordens de serviço em um único lugar.
        </p>

    </div>

    <div class="row g-3">

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="fs-2 mb-3"><i class="bi bi-clipboard-check fs-2 text-primary"></i></div>
                    <h5 class="fw-semibold">Ordens de Serviço</h5>
                    <p class="text-secondary small">
                        Consulte e acompanhe os serviços da oficina.
                    </p>
                    <span class="text-primary fw-semibold">
                        Em desenvolvimento
                    </span>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="fs-2 mb-3"><i class="bi bi-car-front-fill fs-2 text-warning"></i></div>
                    <h5 class="fw-semibold">Veículos</h5>
                    <p class="text-secondary small">
                        Gerencie os veículos cadastrados.
                    </p>
                    <span class="text-primary fw-semibold">
                        Em desenvolvimento
                    </span>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="fs-2 mb-3"><i class="bi bi-people-fill fs-2 text-success"></i></div>
                    <h5 class="fw-semibold">Clientes</h5>
                    <p class="text-secondary small">
                        Acesse os cadastros de clientes.
                    </p>
                    <span class="text-primary fw-semibold">
                        Em desenvolvimento
                    </span>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="fs-2 mb-3"><i class="bi bi-person-badge-fill fs-2 text-info"></i></div>
                    <h5 class="fw-semibold">Funcionários</h5>
                    <p class="text-secondary small">
                        Consulte os funcionários da oficina.
                    </p>
                    <span class="text-primary fw-semibold">
                        Em desenvolvimento
                    </span>
                </div>
            </div>
        </div>

    </div>

</div>